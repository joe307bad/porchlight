<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Porchlight.Server</RootNamespace>
    <!--
      The server has no wwwroot; UnityWebHost serves the WebGL build itself. Turning static web
      assets off also stops dotnet watch on macOS failing to read a manifest path it builds with a
      Windows backslash (obj\Debug/...).
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/Porchlight.Shared.csproj" />
  </ItemGroup>

</Project>
