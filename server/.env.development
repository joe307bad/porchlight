# The dev Keycloak from infra/dev/docker-compose.yml, provisioned by
# infra/keycloak/init-keycloak.sh dev (which sets this same client secret).
APP_URL=http://localhost:5173
KEYCLOAK_ISSUER=http://localhost:8080/realms/porchlight
KEYCLOAK_CLIENT_ID=porchlight-web
KEYCLOAK_CLIENT_SECRET=porchlight-dev-secret
SESSION_SECRET=porchlight-dev-session-secret-not-for-production
PORT=3017
# The game database from infra/dev/docker-compose.yml (service `db`).
DATABASE_URL=postgres://game:devpassword@localhost:5434/city
