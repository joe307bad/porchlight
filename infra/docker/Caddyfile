# Porchlight: the game and its sign-in on {$DOMAIN}, Keycloak on auth.{$DOMAIN}.
# Caddy gets and renews both certificates itself (needs both A records first).

{$DOMAIN} {
	encode zstd gzip

	# Crawlers. Reflectionbot rendered made-up paths (each one used to answer
	# with the game's page), and every render pulled the ~24 MB WebGL build:
	# ~750 GB a day of egress from ~95 IPs (#26). Drop its connections
	# outright. Everyone else is asked to keep out of the build and the game.
	# (A handle of its own, first: a bare `abort` sorts after the handles below
	# and would never run.)
	@badbots header_regexp User-Agent (?i)reflectionbot
	handle @badbots {
		abort
	}
	handle /robots.txt {
		header Content-Type text/plain
		respond "User-agent: *
Disallow: /Build/
Disallow: /mp/
Disallow: /auth/
Disallow: /manage/

User-agent: Reflectionbot
Disallow: /
"
	}

	# The build is also served by the CDN (cdn.{$DOMAIN}, CloudFront, which
	# fetches it from here), so the page loads it from another origin: let any
	# page read it (it's public), and answer the preflight Unity's loader causes
	# when it revalidates its cached copy (If-None-Match isn't a simple header).
	@build path /Build/*
	header @build Access-Control-Allow-Origin *
	header @build Access-Control-Expose-Headers "ETag, Last-Modified, Content-Length, Content-Encoding"
	@buildPreflight {
		method OPTIONS
		path /Build/*
	}
	handle @buildPreflight {
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers *
		header Access-Control-Max-Age 86400
		respond 204
	}

	# The auth service: same origin as the app, so its cookies are first-party.
	handle /auth/* {
		reverse_proxy auth:3017
	}

	# Manage Porchlight's live traffic feed: one long response of small binary
	# frames, each passed on the moment it comes (and not compressed: the
	# server marks it no-transform).
	handle /mp/traffic/feed {
		reverse_proxy auth:3017 {
			flush_interval -1
		}
	}

	# Multiplayer (the same service): characters, matchmaking and the game's
	# WebSockets, which Caddy proxies as they are. Same origin, so the session
	# cookie goes along.
	handle /mp/* {
		reverse_proxy auth:3017
	}

	# Manage Porchlight (manage/, a React app): built into the game's
	# StreamingAssets, so it's in the game's build here. One page; any path
	# under /manage/ that isn't one of its files is that page.
	redir /manage /manage/
	handle /manage/* {
		root * /srv/site/StreamingAssets
		header Cache-Control "no-cache"
		try_files {path} /manage/index.html
		file_server
	}

	# The game: the Unity WebGL build (unity/Builds/WebGL), copied here by the
	# deploy. Its big files are gzipped by Unity and named .unityweb: say so,
	# so the browser unzips them (and compiles the wasm as it streams). Their
	# names don't change between builds, so everything is revalidated (ETags)
	# rather than cached for good; the game also keeps them in IndexedDB.
	#
	# Only real files: / is the game (index.html), and anything that isn't a
	# file is a 404. It used to fall back to the game's page, so every made-up
	# path was a "page" a crawler could render, each pulling the whole build
	# (#26).
	handle {
		root * /srv/site
		@unityweb path /Build/*.unityweb
		header @unityweb Content-Encoding gzip
		@wasm path /Build/*.wasm.unityweb
		header @wasm Content-Type application/wasm
		@js path /Build/*.js.unityweb
		header @js Content-Type application/javascript
		@data path /Build/*.data.unityweb
		header @data Content-Type application/octet-stream
		header Cache-Control "no-cache"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Keycloak. Caddy forwards the original scheme and host (X-Forwarded-*), which
# KC_PROXY_HEADERS=xforwarded tells Keycloak to trust.
auth.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy keycloak:8080

	log {
		output stdout
		format json
	}
}
