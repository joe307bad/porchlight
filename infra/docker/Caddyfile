# Porchlight: the game and its sign-in on {$DOMAIN}, Keycloak on auth.{$DOMAIN}.
# Caddy gets and renews both certificates itself (needs both A records first).

{$DOMAIN} {
	encode zstd gzip

	# The auth service: same origin as the app, so its cookies are first-party.
	handle /auth/* {
		reverse_proxy auth:3017
	}

	# Multiplayer (the same service): characters, matchmaking and the game's
	# WebSockets, which Caddy proxies as they are. Same origin, so the session
	# cookie goes along.
	handle /mp/* {
		reverse_proxy auth:3017
	}

	# The game: the Unity WebGL build (unity/Builds/WebGL), copied here by the
	# deploy. Its big files are gzipped by Unity and named .unityweb: say so,
	# so the browser unzips them (and compiles the wasm as it streams). Their
	# names don't change between builds, so everything is revalidated (ETags)
	# rather than cached for good; the game also keeps them in IndexedDB.
	handle {
		root * /srv/site
		@unityweb path /Build/*.unityweb
		header @unityweb Content-Encoding gzip
		@wasm path /Build/*.wasm.unityweb
		header @wasm Content-Type application/wasm
		@js path /Build/*.js.unityweb
		header @js Content-Type application/javascript
		@data path /Build/*.data.unityweb
		header @data Content-Type application/octet-stream
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Keycloak. Caddy forwards the original scheme and host (X-Forwarded-*), which
# KC_PROXY_HEADERS=xforwarded tells Keycloak to trust.
auth.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy keycloak:8080

	log {
		output stdout
		format json
	}
}
