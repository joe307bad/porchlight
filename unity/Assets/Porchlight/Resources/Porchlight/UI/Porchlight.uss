/* app/src/style.css in UI Toolkit's terms. UI Toolkit has no grid and no gap,
   so grids are wrapping rows of fixed-share children and gaps are margins;
   sizes are the same CSS pixels (the panel scales by the device pixel ratio). */

.root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    color: #efe6cf;
    -unity-font-definition: url("project://database/Assets/Porchlight/Resources/Porchlight/Fonts/Inter-Regular.ttf");
    font-size: 13px;
}

.mono {
    -unity-font-definition: url("project://database/Assets/Porchlight/Resources/Porchlight/Fonts/RobotoMono-Regular.ttf");
}

.bold {
    -unity-font-definition: url("project://database/Assets/Porchlight/Resources/Porchlight/Fonts/Inter-SemiBold.ttf");
}

.semibold {
    -unity-font-definition: url("project://database/Assets/Porchlight/Resources/Porchlight/Fonts/Inter-SemiBold.ttf");
}

Label {
    padding: 0;
    margin: 0;
    -unity-text-align: middle-left;
    white-space: normal;
}

/* The two views. */
#map, #iso {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    right: 300px;
}

.sidebar-closed #map, .sidebar-closed #iso, .narrow #map, .narrow #iso {
    right: 0;
}

#map {
    background-color: #2b2a27;
    overflow: hidden;
}

/* Buttons. */
.btn {
    margin: 0;
    padding: 5px 9px;
    border-width: 1px;
    border-color: #555555;
    border-radius: 0;
    background-color: #1d1c1a;
    color: #efe6cf;
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.btn:hover {
    border-color: #888888;
}

.btn.active {
    background-color: #3f7d4f;
    border-color: #3f7d4f;
}

.btn-regenerate, .btn-primary {
    border-width: 0;
    border-radius: 0;
    background-color: #2f6fd6;
    color: #ffffff;
    font-size: 14px;
    padding: 10px 12px;
    -unity-font-definition: url("project://database/Assets/Porchlight/Resources/Porchlight/Fonts/Inter-SemiBold.ttf");
}

.btn-regenerate:hover {
    background-color: #3b7fe6;
}

.btn-primary {
    background-color: #3f7d4f;
}

.btn-primary:hover {
    background-color: #458a57;
}

.btn-primary:disabled {
    opacity: 0.6;
}

.link {
    margin: 12px 0 0 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #a99f88;
    font-size: 12px;
    -unity-text-align: middle-left;
    align-self: flex-start;
}

.link:hover {
    color: #efe6cf;
}

.link-text {
    border-bottom-width: 1px;
    border-bottom-color: #a99f88;
}

/* Sidebar. */
#sidebar {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 300px;
    background-color: #1f1e1b;
    border-left-width: 1px;
    border-left-color: #444038;
    transition-property: translate;
    transition-duration: 0.2s;
    transition-timing-function: ease;
}

.sidebar-closed #sidebar {
    translate: 100% 0;
}

.sb-scroll {
    flex-grow: 1;
}

.sb-body {
    padding: 18px 18px 24px 18px;
}

.sb-body > * {
    margin-bottom: 18px;
}

.sb-collapse {
    position: absolute;
    top: 14px;
    left: -32px;
    width: 32px;
    height: 36px;
    border-width: 1px;
    border-right-width: 0;
    border-color: #444038;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    background-color: #1f1e1b;
    color: #efe6cf;
    font-size: 16px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
}

.sb-actions {
    flex-direction: row;
    margin-top: 14px;
}

.sb-actions > .btn {
    flex-grow: 1;
    flex-basis: 0;
    padding: 10px 12px;
    font-size: 14px;
}

.sb-actions > .btn.first {
    margin-right: 8px;
}

.sb-seed {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}

.sb-seed-label {
    margin-right: 8px;
    color: #a99f88;
    font-size: 12px;
}

#seed {
    flex-grow: 1;
    margin: 0;
}

#seed > .unity-text-field__input, .picker-name > .unity-text-field__input {
    padding: 5px 7px;
    border-width: 1px;
    border-color: #555555;
    border-radius: 5px;
    background-color: #1d1c1a;
    color: #efe6cf;
    font-size: 13px;
}

.sb-slider {
    margin-bottom: 14px;
}

.sb-slider-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4px;
    font-size: 13px;
}

.sb-slider-value {
    font-size: 12px;
    color: #a99f88;
}

/* Range inputs, in the accent colour. */
.range {
    margin: 0;
    padding: 0;
    height: 16px;
}

.range .unity-base-slider__tracker {
    height: 4px;
    margin-top: -2px;
    border-radius: 2px;
    border-width: 0;
    background-color: #5b5852;
}

.range .unity-base-slider__fill {
    background-color: #c2412d;
    border-radius: 2px;
}

.range .unity-base-slider__dragger {
    width: 16px;
    height: 16px;
    margin-top: -8px;
    border-radius: 8px;
    border-width: 0;
    background-color: #c2412d;
}

.range .unity-base-slider__dragger-border {
    display: none;
}

.check {
    flex-direction: row;
    align-items: center;
    font-size: 13px;
    margin: 0;
}

.check > .unity-toggle__input {
    flex-grow: 0;
}

.check .unity-toggle__checkmark {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    border-width: 1px;
    border-color: #767676;
    background-color: #ffffff;
    margin-right: 6px;
}

.check:checked .unity-toggle__checkmark {
    background-color: #c2412d;
    border-color: #c2412d;
}

.check > Label {
    font-size: 13px;
    color: #efe6cf;
}

.player-row {
    flex-direction: row;
    align-items: center;
    margin: 0 0 6px 0;
    padding: 2px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.player-tick {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    border-radius: 3px;
    border-width: 1px;
    border-color: #767676;
    background-color: #ffffff;
    margin-right: 8px;
}

.player-tick.on {
    background-color: #c2412d;
    border-color: #c2412d;
}

.player-name {
    font-size: 13px;
    color: #efe6cf;
}

.player-row:hover > .player-name {
    color: #ffffff;
}

.help-text {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: 12px;
    color: #a99f88;
    white-space: normal;
}

.sb-joins {
    padding-top: 10px;
}
.sb-joins > .btn {
    margin-top: 4px;
}
/* Footer: hover readout and status. */
#footer {
    position: absolute;
    left: 12px;
    bottom: 12px;
}

.footer-line {
    padding: 4px 8px;
    margin-top: 4px;
    background-color: rgba(28, 27, 24, 0.92);
    border-radius: 5px;
    font-size: 12px;
    align-self: flex-start;
}

.footer-status {
    color: #a99f88;
}

.footer-status.error {
    color: #ff8a73;
}

/* Explore overlay. */
.minimap {
    position: absolute;
    left: 14px;
    bottom: 14px;
    border-width: 1px;
    border-color: #444038;
    border-radius: 6px;
    overflow: hidden;
}

.street-hud {
    position: absolute;
    top: 14px;
    /* Clear of the sidebar's open/close tab (32px, hanging over the view). */
    right: 54px;
    width: 300px;
    padding: 8px 10px;
    border-radius: 6px;
    background-color: rgba(28, 27, 24, 0.92);
    font-size: 12px;
    color: #a99f88;
}

.street-hud-name {
    flex-direction: row;
    align-items: center;
    font-size: 14px;
    color: #f4f1ea;
}

.street-hud-sign {
    width: 14px;
    height: 9px;
    margin-right: 8px;
    border-width: 1.5px;
    border-color: #f4f1ea;
    border-radius: 2px;
    background-color: #24603f;
    flex-shrink: 0;
}

.street-hud-steps {
    margin-top: 8px;
}

.hud-step {
    flex-direction: row;
    align-items: flex-start;
    padding: 3px 6px;
    margin-bottom: 2px;
    border-radius: 4px;
}

.hud-step.current {
    background-color: rgba(255, 106, 0, 0.22);
}

.hud-step-icon {
    width: 16px;
    margin-right: 8px;
    -unity-text-align: upper-center;
    color: #ff8a3d;
}

.hud-step-text {
    flex-grow: 1;
    flex-shrink: 1;
    color: #a99f88;
    font-size: 12px;
}

.hud-step.current > .hud-step-text, .hud-step.current > .hud-step-dist {
    color: #f4f1ea;
}

.hud-step-dist {
    margin-left: 8px;
    flex-shrink: 0;
    color: #a99f88;
    font-size: 12px;
}

.hud-step.more > .hud-step-text {
    padding-left: 24px;
    -unity-font-style: italic;
}

.hud-prompt, .net-notice {
    position: absolute;
    padding: 6px 12px;
    border-radius: 6px;
    background-color: rgba(28, 27, 24, 0.92);
    color: #f4f1ea;
    font-size: 13px;
    white-space: nowrap;
}

.hud-prompt {
    bottom: 52px;
}

.net-notice {
    top: 12px;
    white-space: normal;
}

/* Overlays: sign-in and "Who's playing?". */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
}

/* The sign-in card floats over a little town going about its day. */
#signin {
    background-color: rgba(20, 19, 17, 0.28);
}

#picker {
    background-color: rgba(20, 19, 17, 0.6);
}

.card {
    padding: 32px 28px;
    border-width: 1px;
    border-color: #444038;
    border-radius: 12px;
    background-color: #1f1e1b;
}

.signin-card {
    width: 340px;
    max-width: 100%;
    align-items: stretch;
}

.signin-card > Label {
    -unity-text-align: middle-center;
}

.signin-title {
    margin-bottom: 24px;
    font-size: 40px;
    -unity-font-definition: url("project://database/Assets/Porchlight/Resources/Porchlight/Fonts/TimesNewNormal-Regular.ttf");
    color: #ffffff;
    text-shadow: 4px 4px 0 #000000;
}

.signin-button {
    padding: 11px 16px;
    border-width: 0;
    border-radius: 0;
    background-color: #2f6fd6;
    color: #ffffff;
    font-size: 15px;
}

.signin-button:hover {
    background-color: #3b7fe6;
}

.signin-error, .picker-error {
    margin-top: 16px;
    color: #ff8a73;
    font-size: 14px;
}

.picker-card {
    width: 380px;
    max-width: 100%;
    padding: 26px 24px 20px 24px;
}

.picker-title {
    margin-bottom: 6px;
    font-size: 22px;
}

.picker-hint {
    margin-bottom: 16px;
    font-size: 13px;
    color: #a99f88;
}

.picker-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.picker-play {
    flex-grow: 1;
    margin: 0 6px 0 0;
    padding: 10px 14px;
    border-width: 0;
    border-radius: 0;
    background-color: #c2412d;
    color: #ffffff;
    font-size: 13px;
    -unity-text-align: middle-left;
}

.picker-play:hover, .picker-create:hover {
    background-color: #d5482f;
}

.picker-delete {
    width: 40px;
    margin: 0;
    border-width: 1px;
    border-color: #444038;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #a99f88;
    font-size: 18px;
}

.picker-empty {
    font-size: 13px;
    color: #a99f88;
    margin-bottom: 8px;
}

.picker-new {
    flex-direction: row;
    margin-top: 8px;
}

.picker-name {
    flex-grow: 1;
    margin: 0 6px 0 0;
}

.picker-name > .unity-text-field__input {
    padding: 9px 10px;
    border-color: #444038;
    border-radius: 8px;
    background-color: #2a2925;
}

.picker-create {
    margin: 0;
    padding: 9px 14px;
    border-width: 0;
    border-radius: 0;
    background-color: #3b3934;
    color: #efe6cf;
    font-size: 13px;
}

.picker-create:disabled {
    opacity: 0.6;
}

/* The debug panel (lil-gui), top left. */
.debug-panel {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 245px;
    background-color: #1f1f1f;
    color: #ebebeb;
    font-size: 11px;
}

.debug-title {
    padding: 0 8px;
    height: 24px;
    background-color: #111111;
    -unity-text-align: middle-left;
    font-size: 11px;
}

.debug-folder-head {
    height: 22px;
    padding-left: 8px;
    border-top-width: 1px;
    border-top-color: #2c2c2c;
    -unity-text-align: middle-left;
    font-size: 11px;
}

.debug-folder-body {
    padding-left: 8px;
}

.debug-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding-right: 6px;
}

.debug-label {
    width: 40%;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.debug-slider {
    flex-grow: 1;
    margin: 0 6px 0 0;
}

.debug-slider .unity-base-slider__tracker {
    background-color: #424242;
    height: 18px;
    margin-top: -9px;
    border-width: 0;
    border-radius: 2px;
}

.debug-slider .unity-base-slider__fill {
    background-color: #2cc9ff;
}

.debug-slider .unity-base-slider__dragger {
    width: 0;
    border-width: 0;
}

.debug-value {
    width: 46px;
    font-size: 11px;
    color: #2cc9ff;
    -unity-text-align: middle-right;
}

.debug-button {
    margin: 2px 6px 2px 0;
    padding: 2px;
    height: 18px;
    border-width: 0;
    border-radius: 0;
    background-color: #424242;
    color: #ebebeb;
    font-size: 11px;
}

.hidden {
    display: none;
}

/* Your character and your car, beside the minimap. */
.garage {
    position: absolute;
    left: 286px;
    bottom: 14px;
    flex-direction: column;
}

.garage-box {
    width: 64px;
    height: 64px;
    margin-top: 8px;
    border-width: 2px;
    border-color: #444038;
    border-radius: 6px;
    background-color: #2b2a27;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: flex-end;
    overflow: hidden;
}

.garage-box:hover {
    border-color: #767676;
}


.garage-label {
    font-size: 10px;
    color: #efe6cf;
    background-color: rgba(20, 19, 17, 0.6);
    -unity-text-align: middle-center;
    padding: 1px 0;
}

/* Choosing a character or a car: a grid of them over the view. */
.chooser {
    background-color: rgba(10, 10, 9, 0.55);
}

.chooser-card {
    width: 560px;
    max-width: 100%;
    max-height: 90%;
    padding: 18px 18px 14px 18px;
}

.chooser-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.chooser-title {
    font-size: 18px;
}

.chooser-close {
    font-size: 16px;
    padding: 2px 9px;
    border-radius: 0;
}

.chooser-scroll {
    flex-shrink: 1;
}

.chooser-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.chooser-tile {
    width: 96px;
    height: 96px;
    margin: 0 8px 8px 0;
    border-width: 2px;
    border-color: #444038;
    border-radius: 6px;
    background-color: #2b2a27;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: flex-end;
    overflow: hidden;
}

.chooser-tile:hover {
    border-color: #767676;
}

.chooser-tile.current {
    border-color: #c2412d;
}
/* Where the controller's cursor is (LB / RB step it, A picks). */
.chooser-tile.highlighted {
    border-color: #f2e6c9;
    border-width: 3px;
}

/* Pressable buttons: a lip along the bottom that the button sinks into while
   held, and rises back out of when let go. Height lost from the lip comes back
   as margin, so nothing around it moves. */
.press {
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
    margin-bottom: 0;
    translate: 0 0;
    transition-property: translate, border-bottom-width, margin-bottom, background-color;
    transition-duration: 0.07s, 0.07s, 0.07s, 0.12s;
    transition-timing-function: ease-out;
}

.press:hover {
    translate: 0 -1px;
}

.press:active {
    translate: 0 2px;
    border-bottom-width: 1px;
    margin-bottom: 2px;
}

.press:disabled {
    translate: 0 0;
}

.btn.press {
    border-bottom-color: #0d0c0b;
}

.btn-regenerate.press {
    border-bottom-color: #1d4690;
}

.btn-primary.press {
    border-bottom-color: #285233;
}

.signin-button.press {
    border-bottom-color: #1d4690;
}

.picker-play.press, .picker-create.press {
    border-bottom-color: #7e2a1d;
}

/* The sidebar's top: who you're playing as, the seed, and the big buttons. */
.sb-top {
    padding-bottom: 18px;
    border-bottom-width: 1px;
    border-bottom-color: #383530;
}

.sb-head-label {
    font-size: 11px;
    letter-spacing: 0.9px;
    color: #a99f88;
    -unity-text-align: middle-left;
}

.sb-playing-name {
    margin-top: 4px;
    font-size: 20px;
    color: #efe6cf;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sb-playing-detail {
    margin-top: 2px;
    font-size: 12px;
    color: #a99f88;
}

.sb-links {
    flex-direction: row;
}

.sb-links > .link {
    margin: 6px 14px 0 0;
}

/* The sections: one open at a time, each under a heading that opens it. */
.sb-body > .sb-section {
    margin-bottom: 0;
}

.sb-section {
    border-bottom-width: 1px;
    border-bottom-color: #383530;
}

.sb-section-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
}

.sb-section-head:hover > .sb-head-label, .sb-section-head:hover > .sb-section-arrow {
    color: #efe6cf;
}

.sb-section-arrow {
    font-size: 16px;
    color: #a99f88;
    rotate: 0deg;
    transition-property: rotate;
    transition-duration: 0.15s;
}

.sb-section.open > .sb-section-head > .sb-section-arrow {
    rotate: 90deg;
}

.sb-section-body {
    padding-bottom: 16px;
}

.sb-sub-label {
    margin: 16px 0 10px 0;
    font-size: 11px;
    letter-spacing: 0.9px;
    color: #a99f88;
}

/* Controls: a controller button and a key for each. */
.ctl-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}

.ctl-icons {
    flex-direction: row;
    width: 150px;
    flex-shrink: 0;
}

.ctl-pad {
    flex-direction: row;
    align-items: center;
    width: 66px;
}

.ctl-keys {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    width: 84px;
}

.ctl-text {
    flex-shrink: 1;
    font-size: 12px;
    color: #efe6cf;
}

.ctl-list > .help-text {
    margin-top: 8px;
}

.pad {
    align-items: center;
    justify-content: center;
    margin-right: 3px;
    height: 20px;
    background-color: #3a3833;
    border-width: 1px;
    border-color: #55524a;
}

.pad-label {
    font-size: 10px;
    color: #efe6cf;
    -unity-text-align: middle-center;
}

.pad-face {
    width: 20px;
    border-radius: 10px;
    background-color: #24231f;
    border-width: 1.5px;
}

.pad-a { border-color: #6cbf4a; }
.pad-a > .pad-label { color: #8fdc6c; }
.pad-b { border-color: #d9493b; }
.pad-b > .pad-label { color: #f07364; }
.pad-x { border-color: #3f86d9; }
.pad-x > .pad-label { color: #6fa9f0; }
.pad-y { border-color: #e2b23a; }
.pad-y > .pad-label { color: #f2cd63; }

.pad-bumper {
    width: 26px;
    height: 14px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.pad-trigger {
    width: 20px;
    height: 22px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.pad-stick {
    width: 20px;
    border-radius: 10px;
    border-width: 3px;
    border-color: #55524a;
    background-color: #2a2925;
}

.pad-dpad {
    width: 18px;
    height: 18px;
    border-radius: 3px;
}

.pad-small {
    width: 16px;
    height: 16px;
    border-radius: 8px;
}

.pad-view {
    position: absolute;
    width: 6px;
    height: 5px;
    border-width: 1px;
    border-color: #efe6cf;
    border-radius: 1px;
}

.pad-view-back {
    left: 3px;
    top: 3px;
}

.pad-view-front {
    left: 5px;
    top: 6px;
    background-color: #3a3833;
}

.pad-menu-line {
    width: 7px;
    height: 1px;
    margin: 1px 0;
    background-color: #efe6cf;
}

.keycap {
    align-items: center;
    justify-content: center;
    min-width: 19px;
    height: 19px;
    margin: 0 3px 2px 0;
    padding: 0 4px;
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: #4c4943;
    border-bottom-color: #2c2a26;
    border-radius: 4px;
    background-color: #34322d;
}

.keycap-label {
    font-size: 10px;
    color: #efe6cf;
    -unity-text-align: middle-center;
}

.keycap-wide {
    padding: 0 6px;
}

/* The sign-in card: no card at all, just the title and the button over the town. */
.signin-card {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* The open section's heading, pinned over the top of the sidebar once it has scrolled away. */
.sb-pinned {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 14px 18px;
    background-color: #1f1e1b;
    border-bottom-width: 1px;
    border-bottom-color: #383530;
}

/* The big map (Start, or M): the whole town over the view, to set a waypoint on. */
.bigmap-backdrop {
    background-color: rgba(10, 10, 9, 0.6);
}

.bigmap {
    align-items: center;
}

.bigmap-picture {
    border-width: 2px;
    border-color: #444038;
    background-color: #2b2a27;
    -unity-background-scale-mode: stretch-to-fill;
}

.bigmap-hint {
    margin-top: 12px;
    padding: 6px 12px;
    background-color: rgba(28, 27, 24, 0.92);
    color: #f4f1ea;
    font-size: 13px;
}

/* Missions: the sidebar's list, the objective atop the street panel, and the conversation. */
.mission-row {
    margin-bottom: 12px;
}

.mission-title {
    font-size: 13px;
    color: #efe6cf;
}

.mission-summary {
    margin: 2px 0 6px 0;
}

.mission-error {
    margin: 2px 0 0 0;
    font-size: 12px;
    color: #e0806e;
}

.mission-button {
    align-self: flex-start;
    padding: 6px 14px;
    font-size: 13px;
}

.hud-objective {
    padding-bottom: 6px;
}

.hud-objective-mission {
    font-size: 10px;
    letter-spacing: 0.9px;
    color: #ff8a3d;
}

.hud-objective-text {
    margin-top: 2px;
    font-size: 14px;
    color: #f4f1ea;
    white-space: normal;
}

.dialogue {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 92px;
    align-items: center;
    padding: 0 16px;
}

.dialogue-card {
    width: 520px;
    max-width: 100%;
    padding: 12px 16px 10px 16px;
    border-width: 1px;
    border-color: #444038;
    border-radius: 10px;
    background-color: rgba(28, 27, 24, 0.95);
}

.dialogue-speaker {
    margin-bottom: 4px;
    font-size: 12px;
    letter-spacing: 0.5px;
    color: #ff8a3d;
}

.dialogue-speaker.you {
    color: #7fb7e6;
}

.dialogue-text {
    font-size: 15px;
    color: #f4f1ea;
    white-space: normal;
}

.dialogue-choices {
    margin-top: 2px;
}

.dialogue-choice {
    flex-direction: row;
    align-items: center;
    margin: 0 0 4px 0;
    padding: 7px 10px;
    border-width: 1px;
    border-color: #444038;
    border-radius: 6px;
    background-color: #1d1c1a;
    -unity-text-align: middle-left;
}

.dialogue-choice:hover, .dialogue-choice.highlighted {
    border-color: #ff8a3d;
    background-color: rgba(255, 106, 0, 0.18);
}

.dialogue-choice-key {
    width: 18px;
    margin-right: 8px;
    font-size: 12px;
    color: #a99f88;
}

.dialogue-choice-text {
    flex-shrink: 1;
    font-size: 14px;
    color: #f4f1ea;
    white-space: normal;
}

.dialogue-hint {
    margin-top: 6px;
    font-size: 11px;
    color: #a99f88;
    -unity-text-align: middle-right;
}
