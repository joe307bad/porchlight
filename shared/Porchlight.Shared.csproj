<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the Unity package's Runtime sources as a normal .NET library so the
    server and tests can use them. The project file lives outside the package
    folder on purpose: Unity imports every file in a package, and bin/ and obj/
    there would cause duplicate-type errors.

    Unity is the strictest consumer, so we target what it supports:
    netstandard2.1 and C# 9 (no records with init, file-scoped namespaces or
    global usings).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Porchlight.Shared</RootNamespace>
    <AssemblyName>Porchlight.Shared</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="com.porchlight.shared/Runtime/**/*.cs" />
  </ItemGroup>

</Project>
